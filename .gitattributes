# Normalise line endings: LF in the repository, checkout default on Windows.
* text=auto eol=lf

# Keep binary assets binary.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# package-lock.json is generated by npm and reviewed by nobody; collapse it in diffs.
package-lock.json -diff linguist-generated=true

# Generated stylesheets: reviewed as output, not as source.
themes/hugo-scratch-theme/assets/css/chroma-light.css linguist-generated=true
themes/hugo-scratch-theme/assets/css/chroma-dark.css linguist-generated=true
